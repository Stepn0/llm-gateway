{
  "listen": ":8080",
  "rateLimit": { "rps": 10, "burst": 20, "idleEvictSeconds": 600 },
  "cache": { "size": 1024, "ttlSeconds": 300 },
  "retry": { "maxAttempts": 3, "baseBackoffMs": 100, "maxBackoffMs": 2000 },
  "breaker": { "failureThreshold": 5, "openSeconds": 30 },
  "providers": [
    {
      "name": "openai",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "timeoutMs": 30000
    },
    {
      "name": "ollama",
      "baseURL": "http://localhost:11434/v1",
      "timeoutMs": 60000
    }
  ]
}
